{
  "name": "modelviz-studio",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @modelviz/server --filter @modelviz/web dev",
    "build": "pnpm --filter @modelviz/web build",
    "start": "pnpm --filter @modelviz/server start",
    "typecheck": "pnpm -r typecheck && tsc -p .",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "typescript": "7.0.2",
    "@types/node": "22.20.5"
  }
}
